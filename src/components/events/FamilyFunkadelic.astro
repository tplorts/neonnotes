---
import InfoCard from "../InfoCard.astro";
import CtaButton from "../CtaButton.astro";
---

<article class="relative border-2 border-charcoal p-5 md:p-8" style="box-shadow: 6px 6px 0px #2b2b2b;">

  <!-- Recap eyebrow -->
  <div class="flex items-center gap-3 mb-4">
    <span class="font-mono font-black text-charcoal text-[10px] tracking-[0.25em] uppercase bg-mustard border-2 border-charcoal px-3 py-1 -rotate-2">★ The Recap ★</span>
    <span class="font-mono font-bold text-charcoal/60 text-[10px] tracking-[0.2em] uppercase">Sunday, Sep 20</span>
  </div>

  <div class="flex items-start gap-4 mb-6">
    <!-- Disco ball: tile grid clipped to circle, hanging wire, mustard glint tiles + light rays -->
    <svg viewBox="0 0 56 68" xmlns="http://www.w3.org/2000/svg" class="w-10 h-12 md:w-14 md:h-16 shrink-0 mt-0 md:mt-1" aria-hidden="true">
      <defs>
        <pattern id="disco-tiles" x="4" y="12" width="8" height="6" patternUnits="userSpaceOnUse">
          <rect x="0.5" y="0.5" width="7" height="5" fill="#c8b48a" stroke="#2b2b2b" stroke-width="0.75"/>
        </pattern>
        <clipPath id="disco-clip">
          <circle cx="28" cy="38" r="24"/>
        </clipPath>
      </defs>
      <!-- hanging wire -->
      <line x1="28" y1="0" x2="28" y2="14" stroke="#2b2b2b" stroke-width="2" stroke-linecap="round"/>
      <!-- ball shadow -->
      <circle cx="30" cy="40" r="24" fill="#2b2b2b" opacity="0.12"/>
      <!-- ball base -->
      <circle cx="28" cy="38" r="24" fill="#c8b48a"/>
      <!-- tile grid -->
      <rect x="4" y="14" width="48" height="48" fill="url(#disco-tiles)" clip-path="url(#disco-clip)"/>
      <!-- mustard glint tiles -->
      <g clip-path="url(#disco-clip)">
        <rect x="12.5" y="18.5" width="7" height="5" fill="#FFC82C" stroke="#2b2b2b" stroke-width="0.75"/>
        <rect x="28.5" y="12.5" width="7" height="5" fill="#FFC82C" stroke="#2b2b2b" stroke-width="0.75"/>
        <rect x="36.5" y="24.5" width="7" height="5" fill="#FFC82C" stroke="#2b2b2b" stroke-width="0.75"/>
        <rect x="20.5" y="30.5" width="7" height="5" fill="#FFC82C" stroke="#2b2b2b" stroke-width="0.75"/>
        <rect x="12.5" y="42.5" width="7" height="5" fill="#FFC82C" stroke="#2b2b2b" stroke-width="0.75"/>
        <rect x="36.5" y="42.5" width="7" height="5" fill="#FFC82C" stroke="#2b2b2b" stroke-width="0.75"/>
        <rect x="20.5" y="54.5" width="7" height="5" fill="#FFC82C" stroke="#2b2b2b" stroke-width="0.75"/>
      </g>
      <!-- ball outline -->
      <circle cx="28" cy="38" r="24" fill="none" stroke="#2b2b2b" stroke-width="2"/>
      <!-- light rays off glint tiles -->
      <line x1="13" y1="20" x2="5"  y2="13" stroke="#FFC82C" stroke-width="1.5" stroke-linecap="round"/>
      <line x1="32" y1="14" x2="35" y2="6"  stroke="#FFC82C" stroke-width="1.5" stroke-linecap="round"/>
      <line x1="40" y1="27" x2="49" y2="21" stroke="#FFC82C" stroke-width="1.5" stroke-linecap="round"/>
      <line x1="13" y1="45" x2="4"  y2="48" stroke="#FFC82C" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
    <h2 class="text-2xl md:text-4xl text-charcoal font-display">
      <span class="decoration-4 decoration-mustard underline underline-offset-4 md:underline-offset-8">The Family Funkadelic:<br class="sm:hidden" /> Live Disco Funk</span>
    </h2>
  </div>
  <p class="text-charcoal text-lg leading-relaxed mb-8">
    We brought the funk — and our little locals brought the moves. Seven musicians from The Noir Movement filled the room with an hour of live disco funk while blankets became dance floors and tiny hands found the groove. Thank you to every family who came out to boogie with us. 🪩
  </p>

  <!-- By the numbers -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-8">

    <InfoCard bg="bg-mustard" label="The Band" class="items-center text-center">
      <p class="font-display text-4xl text-charcoal leading-none">7</p>
      <p class="text-charcoal text-xs font-semibold leading-snug">musicians on stage</p>
    </InfoCard>

    <InfoCard bg="bg-coral" label="The Set" class="items-center text-center">
      <p class="font-display text-4xl text-charcoal leading-none">60</p>
      <p class="text-charcoal text-xs font-semibold leading-snug">minutes of disco funk</p>
    </InfoCard>

    <InfoCard bg="bg-seafoam" label="Shushing" class="items-center text-center">
      <p class="font-display text-4xl text-charcoal leading-none">0</p>
      <p class="text-charcoal text-xs font-semibold leading-snug">times, not once</p>
    </InfoCard>

    <InfoCard bg="bg-charcoal" tone="dark" label="Dance Moves" class="items-center text-center">
      <p class="font-display text-4xl text-mustard leading-none">∞</p>
      <p class="text-sand text-xs font-light leading-snug">busted on the floor</p>
    </InfoCard>

  </div>

  <!-- Closing note -->
  <div class="bg-charcoal border-2 border-mustard p-6 md:p-8 flex flex-col sm:flex-row sm:items-center gap-5" style="box-shadow: 4px 4px 0px #2b2b2b;">
    <p class="text-sand text-base leading-relaxed flex-1">
      <span class="text-mustard font-black">Thank you for grooving with us.</span> Every ticket went straight to our local musicians — and the next session is already in the works.
    </p>
    <div class="shrink-0">
      <CtaButton size="lg">See What's Next</CtaButton>
    </div>
  </div>

</article>
