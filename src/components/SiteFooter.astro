<footer class="bg-charcoal py-16">
  <div class="max-w-2xl mx-auto px-6 flex flex-col items-center text-center">

    <!-- Starburst mark -->
    <img src="/Starburst.png" alt="Neon Notes" class="w-16 h-16 mb-10" />

    <!-- Thin divider -->
    <div class="w-full border-t border-sand/30 mb-10"></div>

    <!-- Contact info -->
    <div class="flex flex-col sm:flex-row gap-10 mb-10">

      <div>
        <p class="font-body font-black text-sand text-xs tracking-[0.3em] uppercase mb-2">Say Hello</p>
        <a href="mailto:neonnoteslv@gmail.com" class="font-mono text-mustard text-sm hover:text-citron transition-colors">
          neonnoteslv@gmail.com
        </a>
      </div>

      <div class="hidden sm:block w-px bg-sand/20"></div>

      <div>
        <p class="font-body font-black text-sand text-xs tracking-[0.3em] uppercase mb-2">Follow Along</p>
        <a href="https://instagram.com/neonnoteslv" target="_blank" rel="noopener noreferrer" class="font-mono text-mustard text-sm hover:text-citron transition-colors">
          @neonnoteslv
        </a>
      </div>

    </div>

    <!-- Copyright -->
    <p class="font-body text-sand/40 text-xs tracking-[0.2em] uppercase">
      Made for Little Locals in Las Vegas &copy; {new Date().getFullYear()} Neon Notes
    </p>

  </div>
</footer>
