---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  heading: string;
  meta: string;
}

const { title, heading, meta } = Astro.props;
---

<style>
  .legal-body {
    font-family: "Roboto", system-ui, sans-serif;
  }
  .legal-body h2 {
    font-family: "Roboto", system-ui, sans-serif;
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #2b2b2b;
    margin-bottom: 0.5rem;
  }
  .legal-body p,
  .legal-body li {
    font-size: 0.9rem;
    line-height: 1.8;
    color: #3a3a3a;
  }
  .legal-body ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .legal-body ul li::before {
    content: "–";
    color: #ffc82c;
    font-weight: 700;
    margin-right: 0.5rem;
  }
</style>

<BaseLayout title={title}>
  <section class="bg-sand-grain min-h-screen py-16">
    <div class="max-w-2xl mx-auto px-6">

      <!-- Logo -->
      <div class="flex justify-center mb-8">
        <a href="/">
          <img src="/logo.png" alt="Neon Notes — Live Music for Little Locals" class="h-20 w-auto" />
        </a>
      </div>

      <div class="bg-white border-2 border-charcoal p-8 md:p-12" style="box-shadow: 6px 6px 0px #2b2b2b;">

        <!-- Page header -->
        <div class="border-b-2 border-charcoal pb-6 mb-8">
          <h1 class="font-display text-3xl text-charcoal mb-1">{heading}</h1>
          <p class="text-xs text-charcoal/50" style="font-family: 'Roboto', sans-serif;">{meta}</p>
        </div>

        <div class="legal-body space-y-8">
          <slot />
        </div>

        <div class="mt-10 pt-6 border-t border-charcoal/10">
          <a href="/" class="font-mono font-black text-xs tracking-[0.2em] uppercase text-charcoal hover:text-mustard transition-colors">← Back to Home</a>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
